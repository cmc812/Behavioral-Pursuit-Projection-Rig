              </Expression>
              <Expression xsi:type="IncludeWorkflow" Path="BonVision:Primitives.DrawImage.bonsai">
                <TextureName>RP</TextureName>
                <ExtentX>0.1</ExtentX>
                <ExtentY>0.1</ExtentY>
                <LocationX>0.5990737</LocationX>
                <LocationY>0.6095833</LocationY>

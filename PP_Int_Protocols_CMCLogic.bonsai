  new(
    it.Item2.Item3.Dot_X as X,
    it.Item2.Item3.Dot_Y as Y
  ) as Green_Dot,
  new(
    it.Item2.Item1.Nose_X as X,
    it.Item2.Item1.Nose_Y as Y
  ) as Nose,
  double.NaN as Trial,
  it.Item2.Item4.Successes as Successes,

                <Combinator xsi:type="FloatProperty">
                  <Value>0.1</Value>
                </Combinator>
              </Expression>
              <Expression xsi:type="Annotation">
                <Name>Approach Distance</Name>
                <Text><![CDATA[]]></Text>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="FloatProperty">
                  <Value>2</Value>
                </Combinator>
              </Expression>
              <Expression xsi:type="Annotation">
                <Name>Trial Duration - Minutes</Name>
                <Text><![CDATA[]]></Text>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="FloatProperty">
                  <Value>2</Value>
                </Combinator>
              </Expression>
              <Expression xsi:type="Combinator">

            <Expression xsi:type="ipy:PythonTransform">
              <ipy:Script>import clr
clr.AddReference("System")
from System import IO, DateTime

@returns(str)
def process(value):
    filename_base = str(value)
    
    timestamp = DateTime.Now.ToString("yyyy-MM-dd'T'HH_mm_ss")
    full_path = filename_base + "bpod_" + timestamp + ".csv"
    
    # Create directory tree if it doesn't exist
    directory = IO.Path.GetDirectoryName(full_path)
    if not IO.Directory.Exists(directory):
        IO.Directory.CreateDirectory(directory)
    
    # Write full path to the exchange file
    exchange_path = "C:/BpodExchange/next_session.txt"
    exchange_dir = IO.Path.GetDirectoryName(exchange_path)
    if not IO.Directory.Exists(exchange_dir):
        IO.Directory.CreateDirectory(exchange_dir)
    
    IO.File.WriteAllText(exchange_path, full_path)
    
    return full_path</ipy:Script>

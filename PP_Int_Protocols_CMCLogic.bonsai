              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="Combinator">
                <Combinator xsi:type="cv:LoadImage">
                  <cv:FileName>C:\Users\psych-aalab\Documents\RAFolder\PursuitProtocols\Laser simulator\Mixed\Shapes\Cyan Shapes\cyan_star.png</cv:FileName>
                  <cv:Mode>Unchanged</cv:Mode>
                </Combinator>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">

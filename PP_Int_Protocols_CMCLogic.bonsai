              <Builder xsi:type="ipy:PythonTransform">
                <ipy:Name>Near Door?</ipy:Name>
                <ipy:Script>import math

sb = -1

@returns(int)
def process(value):
  global sb
  mouse = value.Item1
  state = value.Item2

  if math.isnan(mouse) and (state == 1 or state == 2):
    sb = 7
  elif not math.isnan(mouse) and state == 2:
    sb = 6
  elif not math.isnan(mouse) and state == 5:
    sb = 7
  else:
    sb = -1
  return sb</ipy:Script>
              </Builder>
            </Expression>
            <Expression xsi:type="ipy:PythonTransform">
              <ipy:Name>In Arena?</ipy:Name>
              <ipy:Script>from System import Tuple
import math

arena = -1
start = 0
ir = 0
ir_active = 0
door = 0
closing = 0
mouse_state = 0

@returns(Tuple[int, int])
def process(value):
  global arena, start, ir, ir_active, door, closing, mouse_state
  tail = value.Item1
  nose = value.Item2
  state = value.Item3
  ard = value.Item4
  ard2 = value.Item5

  if tail == 1 and nose == 1:
    mouse_state = 1
  elif tail == 0 and nose == 0:
    mouse_state = 0
  # else: hold last value

  mouse = mouse_state

  if ard.strip() == 'IR:1':
    ir_active = 1
    ir = 1
  elif ard.strip() == 'IR:0':
    ir_active = 0
  elif ard.strip() == 'DOOR_CLOSING':
    closing = 1
  elif ard.strip() == 'DOOR_CLOSED':
    closing = 0
  elif ard.strip() == 'CLOSE_REVERSED':
    closing = 0

  if ard2 != 1:
    arena = 0
    start = 1
    door = 0
  elif start == 1 and ard == "SESSION_FLASH_DONE":
    arena = 4
    start = 0
  elif mouse == 0 and state == 1 and door == 1:
    arena = 0
    ir = 0
    ir_active = 0
  elif mouse == 0 and state == 1:
    arena = 2
    ir = 0
    ir_active = 0
    if ard.strip() == 'DOOR_OPEN':
      door = 1
  elif mouse == 1 and state == 2:
    arena = 7
    door = 0
  elif mouse == 1 and state == 5 and closing == 1:
    arena = 7
    ir = 0
    ir_active = 0
  elif state == 5 and ard.strip() == 'IR:1':
    ir = 1
  elif mouse == 0 and state == 5 and ir == 1 and ir_active == 0:
    arena = 7
  elif mouse == 1 and state == 5 and ard.strip() == "DOOR_CLOSED":
    arena = 6
    ir = 0
    closing = 0
  else:
    arena = -1
  return Tuple[int, int](arena, ir)
</ipy:Script>
            </Expression>

                <Name>Array</Name>
              </Expression>
              <Expression xsi:type="SubscribeSubject">
                <Name>Trial Bounds</Name>
              </Expression>
              <Expression xsi:type="SubscribeSubject">
                <Name>Preview Trial Count</Name>
              </Expression>

                <scr:Expression>it</scr:Expression>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="FloatProperty">
                  <Value>0.7</Value>
                </Combinator>
              </Expression>
              <Expression xsi:type="SubscribeSubject">
                <Name>Dot Tracking</Name>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:CombineLatest" />
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:WithLatestFrom" />
              </Expression>
              <Expression xsi:type="Disable">
                <Builder xsi:type="ipy:PythonTransform">
                  <ipy:Name>Trial Logic Projector</ipy:Name>
                  <ipy:Description>Runs the current trial until the next trial is reached</ipy:Description>
                  <ipy:Script>from System import Tuple
import math

r = 0
state = 2
a = 0
success = 0
trial_type = None

@returns(Tuple[float, float, float, float, float, float, float])
def process(value):
  global r, state, a, success, trial_type
  min_row = value.Item2.Item4[0][int(value.Item2.Item2)][0]
  max_row = value.Item2.Item4[0][int(value.Item2.Item2)][1]
  x = -value.Item2.Item1[r][3]#*0.90-0.20
  y = value.Item2.Item1[r][2]
  mx = value.Item2.Item3.Nose_X
  my = value.Item2.Item3.Nose_Y
  dist = math.sqrt((x - mx) ** 2 + (y - my) ** 2)

  if value.Item2.Item2 == 0 and success &gt; 1:
    a = 0
    state = 6
  elif dist &lt; value.Item2.Item6 and state == 1 and value.Item2.Item2 &gt;= 0: #Approach Distance
    state = 2
  elif r &lt; min_row:
    r = min_row
  elif r &lt; max_row and state == 2:# and dist &lt; value.Item2.Item6:
    r += 1
    a = 1
    if dist &lt;  value.Item2.Item5: #Capture Distance
      r = max_row
      a = 0
      state = 3
      success += 1
  elif state == 3 or state == 4:
    state = 5
  elif r &gt;= max_row and state == 2:
    r = max_row
    a = 0
    state = 4
  elif r != max_row:
    a = 1
    state = 2
  
  return Tuple[float, float, float, float, float, float, float](x, y, mx, my, success, a, state)</ipy:Script>
                </Builder>
              </Expression>
              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Name>Trial Logic Remote</ipy:Name>
                <ipy:Description>Runs the current trial until the next trial is reached</ipy:Description>
                <ipy:Script>from System import Tuple
import math

r = 0
state = 2
a = 0
success = 0
trial_type = None

@returns(Tuple[float, float, float, float, float, float, float])
def process(value):

Convert.ToInt32(it) == 187 ? 2 :
Convert.ToInt32(it) == 219 ? 6 :
Convert.ToInt32(it) == 221 ? 7 :
Convert.ToInt32(it) == 67 ? 22 :
-1</scr:Expression>

              </Expression>
              <Expression xsi:type="rx:Condition">
                <Workflow>
                  <Nodes>
                    <Expression xsi:type="WorkflowInput">
                      <Name>Source1</Name>
                    </Expression>
                    <Expression xsi:type="Equal">
                      <Operand xsi:type="WorkflowProperty" TypeArguments="sys:Byte">
                        <Value>3</Value>
                      </Operand>
                    </Expression>
                    <Expression xsi:type="WorkflowOutput" />
                  </Nodes>
                  <Edges>
                    <Edge From="0" To="1" Label="Source1" />
                    <Edge From="1" To="2" Label="Source1" />
                  </Edges>
                </Workflow>
              </Expression>
              <Expression xsi:type="SubscribeSubject">
                <Name>Trial Type</Name>
              </Expression>
              <Expression xsi:type="SubscribeSubject">
                <Name>Trial Types</Name>
              </Expression>
              <Expression xsi:type="SubscribeSubject">
                <Name>Trial Count</Name>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:CombineLatest" />
              </Expression>
              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Name>Designate Reward</ipy:Name>
                <ipy:Script>from System import Tuple

@returns(Tuple[int, int])
def process(value):
  if value.Item1 == "RP":
    b = 3
  elif value.Item1 != "CP" and value.Item2[0][int(value.Item3)] == 0:
    b = 3
  else:
    b = 13
  return Tuple[int, int](b, value.Item2[0][int(value.Item3)])</ipy:Script>
              </Expression>
              <Expression xsi:type="MemberSelector">
                <Selector>Item1</Selector>
              </Expression>
              <Expression xsi:type="PropertyMapping">
                <PropertyMappings>
                  <Property Name="Value" />
                </PropertyMappings>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="ByteProperty">
                  <Value>13</Value>
                </Combinator>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:Take">
                  <rx:Count>1</rx:Count>
                </Combinator>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:ToArray" />
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="port:SerialWrite">
                  <port:PortName>COM3</port:PortName>
                </Combinator>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:DistinctUntilChanged" />
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:Repeat" />
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:Delay">
                  <rx:DueTime>PT1S</rx:DueTime>
                </Combinator>
              </Expression>
              <Expression xsi:type="rx:Condition">
                <Workflow>
                  <Nodes>
                    <Expression xsi:type="WorkflowInput">
                      <Name>Source1</Name>
                    </Expression>
                    <Expression xsi:type="Equal">
                      <Operand xsi:type="WorkflowProperty" TypeArguments="sys:Byte">
                        <Value>4</Value>
                      </Operand>
                    </Expression>
                    <Expression xsi:type="WorkflowOutput" />

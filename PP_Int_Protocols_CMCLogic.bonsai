              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Name>Build Trajectory</ipy:Name>
                <ipy:Script>import clr
clr.AddReference("OpenCV.Net")
from OpenCV.Net import Point2f
from System import Array
import math

@returns(Array[Point2f])
def process(value):
    arr = value.Item1
    bounds_list = value.Item2[0]
    trial_idx = value.Item3

    num_trials = len(bounds_list)
    if num_trials == 0:
        return Array[Point2f]([])

    idx = trial_idx % num_trials
    start_row, end_row = bounds_list[idx]

    valid_points = []
    for r in range(start_row, end_row + 1):
        row = arr[r]
        try:
            x_raw = float(row[3])
            y_raw = float(row[2])
        except:
            continue

        if math.isnan(x_raw) or math.isnan(y_raw):
            continue

        valid_points.append(Point2f(-x_raw, y_raw))

    return Array[Point2f](valid_points)</ipy:Script>

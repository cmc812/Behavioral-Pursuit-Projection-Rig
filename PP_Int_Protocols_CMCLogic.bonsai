                      <cv:X>640</cv:X>
                      <cv:Y>0</cv:Y>
                    </cv:Point2f>
                  </cv:Destination>
                  <cv:Flags>Linear</cv:Flags>
                  <cv:FillValue>
                    <cv:Val0>0</cv:Val0>
                    <cv:Val1>0</cv:Val1>
                    <cv:Val2>0</cv:Val2>
                    <cv:Val3>0</cv:Val3>

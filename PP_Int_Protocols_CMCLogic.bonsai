              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Name>Trial Count</ipy:Name>
                <ipy:Script>trial = 0

@returns(int)
def process(value):
  global trial
  key = int(value)
  if key == 39:
    trial += 1
  elif key == 37 and trial &gt; 0:
    trial -= 1
  return trial</ipy:Script>

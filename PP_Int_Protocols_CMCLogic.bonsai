              </Expression>
              <Expression xsi:type="scr:ExpressionCondition">
                <scr:Expression>Convert.ToInt32(it) == 187 || Convert.ToInt32(it) == 189 || Convert.ToInt32(it) == 219 || Convert.ToInt32(it) == 221</scr:Expression>
              </Expression>
              <Expression xsi:type="scr:ExpressionTransform">
                <scr:Name>Arduino Key Bytes</scr:Name>
                <scr:Expression>Convert.ToInt32(it) == 189 ? 0 :
Convert.ToInt32(it) == 187 ? 2 :
Convert.ToInt32(it) == 219 ? 6 :
Convert.ToInt32(it) == 221 ? 7 :
Convert.ToInt32(it) == 67 ? 22 :
-1</scr:Expression>

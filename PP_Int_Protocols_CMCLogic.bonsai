                      <Expression xsi:type="ipy:PythonTransform">
                        <ipy:Name>In Arena?</ipy:Name>
                        <ipy:Script>from System import Tuple
import math

byte = -1
start = 1
ir = 0
state = 0
bpod_out = 0

@returns(Tuple[int, int])
def process(value):
  global byte, start, ir, state, bpod_out
  mouse = value.Item1
  ard = value.Item2
  bpod_in = value.Item3

  if state == 1 and bpod_in == 13:
    byte = 6
    state = 2
  elif state == 2 and mouse == 1:
    byte = 7
    state = 3
  elif state == 3 and bpod_in == 14:
    byte = 6
    state = 4
  elif state == 4 and ard.strip() == 'IR:1':
    ir = 1
  elif mouse == 0 and state == 4 and ir == 1:
    byte = 7
    state = 5
  elif state == 5 and mouse == 1 and ard.strip() == 'DOOR_CLOSED':
    byte = 6
    state = 4
    ir = 0
  elif state == 5 and mouse == 0 and ard.strip() == 'DOOR_CLOSED':
    state = 6
    bpod_out = 2
  else:
    byte = -1
  return Tuple[int, int](byte, bpod_out)</ipy:Script>

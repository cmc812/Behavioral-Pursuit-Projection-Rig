              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Name>Ard Cam Session Start</ipy:Name>
                <ipy:Script>@returns(int)
def process(value):
  ard = value
  if ard.strip() == "SESSION":
    check = 1
  else:
    check = 0
  return check</ipy:Script>
              </Expression>
              <Expression xsi:type="scr:ExpressionTransform">
                <scr:Name>Session Start Check</scr:Name>
                <scr:Expression>it == 1 ? 1 : 0</scr:Expression>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:DistinctUntilChanged" />
              </Expression>
              <Expression xsi:type="rx:BehaviorSubject">
                <Name>SessionStart</Name>
              </Expression>
              <Expression xsi:type="scr:ExpressionCondition">
                <scr:Expression>it == 1</scr:Expression>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:SubscribeWhen" />
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:Take">
                  <rx:Count>1</rx:Count>
                </Combinator>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="IntProperty">
                  <Value>1</Value>
                </Combinator>

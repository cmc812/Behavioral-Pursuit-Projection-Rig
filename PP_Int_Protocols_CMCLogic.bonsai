              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Script>import clr
clr.AddReference("System")
from System.Net import WebRequest
from System.IO import StreamReader, StreamWriter
from System.Text import Encoding
from System import DateTime, IO

OE_URL = "http://localhost:37497"

def put_json(endpoint, json_str):
    req = WebRequest.Create(OE_URL + endpoint)
    req.Method = "PUT"
    req.ContentType = "application/json"
    data = Encoding.UTF8.GetBytes(json_str)
    req.ContentLength = data.Length
    stream = req.GetRequestStream()
    stream.Write(data, 0, data.Length)
    stream.Close()
    resp = req.GetResponse()
    reader = StreamReader(resp.GetResponseStream())
    result = reader.ReadToEnd()
    reader.Close()
    resp.Close()
    return result

@returns(bool)
def process(value):
    trial_type = str(value.Item1)
    animal_id = "PP" + str(value.Item2)
    now = DateTime.Now
    date_folder = now.ToString("MMddyyyy")
    base_text = now.ToString("yyyy-MM-dd_HH-mm-ss")
    
    parent_dir = "E:/Xiaoxiao_pursuit/pp_Int/" + date_folder + "/" + animal_id + "/" + trial_type
    
    if not IO.Directory.Exists(parent_dir):
        IO.Directory.CreateDirectory(parent_dir)
    
    put_json(
        "/api/recording",
        '{"parent_directory": "' + parent_dir + '", "base_text": "' + base_text + '", "prepend_text": "' + animal_id + '_", "append_text": "_' + trial_type + '"}'
    )
    put_json("/api/status", '{"mode": "ACQUIRE"}')
    put_json("/api/status", '{"mode": "RECORD"}')
    return True</ipy:Script>
              </Expression>
              <Expression xsi:type="SubscribeSubject">
                <Name>Stop Workflow</Name>
              </Expression>

                      <cv:Y>347.52</cv:Y>
                    </cv:Point2f>
                    <cv:Point2f>
                      <cv:X>500.869568</cv:X>
                      <cv:Y>351.1111</cv:Y>
                    </cv:Point2f>
                    <cv:Point2f>
                      <cv:X>500.869568</cv:X>
                      <cv:Y>95.87302</cv:Y>
                    </cv:Point2f>
                  </cv:Source>
                  <cv:Destination>
                    <cv:Point2f>
                      <cv:X>0</cv:X>
                      <cv:Y>0</cv:Y>
                    </cv:Point2f>

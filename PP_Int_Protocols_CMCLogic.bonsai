              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:WithLatestFrom" />
              </Expression>
              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Name>Trial Logic</ipy:Name>
                <ipy:Description>Runs the current trial until the next trial is reached</ipy:Description>
                <ipy:Script>from System import Tuple
import math

state = 0
a = 0
success = 0
cap = False
rb = 1
ard = -1
ir = 0

@returns(Tuple[int, int, int, int, int, int])
def process(value):
  global state, a, success, cap, rb, ard, ir
  x = value.Item2.Item1.Item1
  y = value.Item2.Item1.Item2
  mx = value.Item2.Item2.Nose_X
  my = value.Item2.Item2.Nose_Y
  dist = math.sqrt((x - mx) ** 2 + (y - my) ** 2)
  tx = value.Item2.Item5.X
  ty = value.Item2.Item5.Y

  if value.Item2.Item4 == True and state == 0:
    rb = 0
    state = 1
  elif state == 0:
    rb = 1
    a = 1
  elif state == 1 and not math.isnan(tx):
    ard = 7
    state = 2
  elif state == 1 and math.isnan(tx):
    a = 1
  elif state == 2 and dist &lt;= value.Item2.Item3 and cap == False:
    a = 0
    ard = 6
    success += 1
    cap = True
    state = 3
  elif state == 2 and cap == False:
    a = 1
  elif state == 3 and value.Item2.Item6.strip() == "IR:1" and ir == 0:
    ir = 1
  elif state == 3 and math.isnan(tx) and ir == 1:
    ard = 7
    state = 5
  elif state == 5 and value.Item2.Item7 == 1:
    state = 0
    ir = 0
    cap = False
    ard = -1
  else:
    a = 0
  
  return Tuple[int, int, int, int, int, int](success, a, state, rb, ard, value.Item2.Item7)</ipy:Script>
              </Expression>
              <Expression xsi:type="Disable">
                <Builder xsi:type="ipy:PythonTransform">
                  <ipy:Name>Trial Logic</ipy:Name>
                  <ipy:Description>Runs the current trial until the next trial is reached</ipy:Description>
                  <ipy:Script>from System import Tuple
import math

state = 2
a = 0
success = 0
check = None

@returns(Tuple[float, float, float])
def process(value):
  global state, a, success, check
  x = value.Item2.Item1.Item1
  y = value.Item2.Item1.Item2
  mx = value.Item2.Item2.Nose_X
  my = value.Item2.Item2.Nose_Y
  dist = math.sqrt((x - mx) ** 2 + (y - my) ** 2)

  if dist &lt;= value.Item2.Item3 and check != [x,y]:
    a = 0
    state = 2
    success += 1
    check = [x,y]
  elif [x,y] != check and state != 1:
    a = 1
    state = 1
  elif check == [x,y]:
    a = 0
    state = 3
  else:
    a = 1
  
  return Tuple[float, float, float](success, a, state)</ipy:Script>
                </Builder>
              </Expression>
              <Expression xsi:type="scr:ExpressionTransform">
                <scr:Name>Format Results</scr:Name>
                <scr:Expression>new(
  it.Item1 as Successes,
  it.Item2 as Opacity,
  it.Item3 as State,
  it.Item4 as RB,
  it.Item5 as Ard,
  it.Item6 as Bpod
)</scr:Expression>

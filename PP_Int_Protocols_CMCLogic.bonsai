              <scr:Expression>it.Item1 == "m1" || it.Item1 == "f2" || it.Item1 == "f3"
? "E:/Xiaoxiao_pursuit/PursuitProtocols/" + DateTime.Now.ToString("MMM_dd_yyyy") + "_TR_Day" + it.Item2 + "/XLPP_TR_day" + it.Item2 + (
    it.Item1 == "m1" ? "_xx11_"
    : it.Item1 == "f2" ? "_xx15_"
    : it.Item1 == "f3" ? "_xx16_"
    : it.Item1
  )
: "E:/Xiaoxiao_pursuit/pp_Int/" + DateTime.Now.ToString("MMddyyyy") + "/" + "PP" + it.Item1 + "/" + it.Item2 + "/" + "PP" + it.Item1 + "_" + it.Item2 + "_"</scr:Expression>

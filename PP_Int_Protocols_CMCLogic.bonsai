              </Workflow>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>Arrow</Name>
            </Expression>
            <Expression xsi:type="ipy:PythonTransform">
              <ipy:Name>Trial Count</ipy:Name>
              <ipy:Script>from System import Tuple

trial = -1
check = False

@returns(Tuple[float, bool])
def process(value):
  global trial, check
  if trial + 1 != 30 and check == False:
    trial += 1
  else:
    trial = 0
    check = True
  return Tuple[float, bool](trial, check)</ipy:Script>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item1</Selector>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>Trial Count</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Nose Location</Name>
            </Expression>

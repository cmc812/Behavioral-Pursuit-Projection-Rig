              <Combinator xsi:type="FloatProperty">
                <Value>0.1</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>Capture Distance</scr:Name>
              <scr:Expression>it</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="FloatProperty">
                <Value>2</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Dot Tracking</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:CombineLatest" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="ipy:PythonTransform">
                <ipy:Name>Pred Trial Logic_old</ipy:Name>
                <ipy:Script>from System import Tuple
import math

r = 0
state = 1
a = 0
success = 0
trial_type = None
mouse_history = []
max_history = 5

@returns(Tuple[float, float, float, float, float, float, float])
def process(value):
  global r, state, a, success, trial_type, mouse_history
  min_row = value.Item2.Item4[0][int(value.Item2.Item2)][0]
  max_row = value.Item2.Item4[0][int(value.Item2.Item2)][1]
  x = -value.Item2.Item1[r][3]
  y = value.Item2.Item1[r][2]
  mx = value.Item2.Item3.Nose_X
  my = value.Item2.Item3.Nose_Y

  # --- Prediction ---
  mouse_history.append((mx, my))
  if len(mouse_history) &gt; max_history:
    mouse_history[:] = mouse_history[-max_history:]

  if len(mouse_history) &gt;= 2:
    vx = (mx - mouse_history[0][0]) / len(mouse_history)
    vy = (my - mouse_history[0][1]) / len(mouse_history)
    pmx = mx + vx * 2
    pmy = my + vy * 2

    # --- Angle gate ---
    dmx = pmx - mx
    dmy = pmy - my
    dtx = x - mx
    dty = y - my
    mag1 = math.sqrt(dmx**2 + dmy**2)
    mag2 = math.sqrt(dtx**2 + dty**2)
    if mag1 &gt; 0.001 and mag2 &gt; 0.001:
      cos_a = max(-1, min(1, (dmx*dtx + dmy*dty) / (mag1 * mag2)))
      angle = math.acos(cos_a) * 180 / math.pi
    else:
      angle = 0
  else:
    pmx = mx
    pmy = my
    angle = 0

  dist = math.sqrt((x - pmx) ** 2 + (y - pmy) ** 2)

  if value.Item2.Item2 == 0 and success &gt; 1:
    a = 0
    state = 6
  elif dist &lt; value.Item2.Item6 and state == 1 and value.Item2.Item2 &gt;= 0:
    state = 2
  elif r &lt; min_row:
    r = min_row
  elif r &lt; max_row and state == 2:
    r += 1
    a = 1
    if dist &lt; value.Item2.Item5 and angle &lt; 70:
      r = max_row
      a = 0
      state = 3
      success += 1
  elif state == 3 or state == 4:
    state = 5
  elif r &gt;= max_row and state == 2:
    r = max_row
    a = 0
    state = 4
  elif r != max_row:
    a = 1
    state = 1

  return Tuple[float, float, float, float, float, float, float](x, y, mx, my, success, a, state)</ipy:Script>
              </Builder>
            </Expression>
            <Expression xsi:type="ipy:PythonTransform">
              <ipy:Name>Pred Trial Logic</ipy:Name>
              <ipy:Script>from System import Tuple
import math

r = 0
state = 1
a = 0
success = 0
trial_type = None
mouse_history = []
max_history = 5

@returns(Tuple[float, float, float, float, float, float, float])
def process(value):
  global r, state, a, success, trial_type, mouse_history
  min_row = value.Item2.Item4[0][int(value.Item2.Item2)][0]
  max_row = value.Item2.Item4[0][int(value.Item2.Item2)][1]
  x = -value.Item2.Item1[r][3]
  y = value.Item2.Item1[r][2]
  mx = value.Item2.Item3.Nose_X
  my = value.Item2.Item3.Nose_Y

  # --- Prediction ---
  mouse_history.append((mx, my))
  if len(mouse_history) &gt; max_history:
    mouse_history[:] = mouse_history[-max_history:]

  if len(mouse_history) &gt;= 2:
    vx = (mx - mouse_history[0][0]) / len(mouse_history)
    vy = (my - mouse_history[0][1]) / len(mouse_history)
    pmx = mx + vx * 2
    pmy = my + vy * 2

    # --- Angle gate ---
    dmx = pmx - mx
    dmy = pmy - my
    dtx = x - mx
    dty = y - my
    mag1 = math.sqrt(dmx**2 + dmy**2)
    mag2 = math.sqrt(dtx**2 + dty**2)
    if mag1 &gt; 0.001 and mag2 &gt; 0.001:
      cos_a = max(-1, min(1, (dmx*dtx + dmy*dty) / (mag1 * mag2)))
      angle = math.acos(cos_a) * 180 / math.pi
    else:
      angle = 0
  else:
    pmx = mx
    pmy = my
    angle = 0

  dist = math.sqrt((x - pmx) ** 2 + (y - pmy) ** 2)

  if value.Item2.Item2 == 0 and success &gt; 1:
    a = 0
    state = 6
  elif dist &lt; value.Item2.Item6 and state == 1 and value.Item2.Item2 &gt;= 0:
    state = 2
  elif r &lt; min_row:
    r = min_row
  elif r &lt; max_row and state == 2:
    r += 1
    a = 1
    if dist &lt; value.Item2.Item5 and angle &lt; 70:
      r = max_row
      a = 0
      state = 3
      success += 1
  elif state == 3 or state == 4:
    state = 5
  elif r &gt;= max_row and state == 2:
    r = max_row
    a = 0
    state = 4
  elif r != max_row:
    a = 1
    state = 1

  return Tuple[float, float, float, float, float, float, float](x, y, mx, my, success, a, state)</ipy:Script>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="ipy:PythonTransform">
                <ipy:Name>GD Trial Logic</ipy:Name>
                <ipy:Description>Runs the current trial until the next trial is reached</ipy:Description>
                <ipy:Script>from System import Tuple
import math

gr = 0 #ghost dot
r = 0
state = 1
a = 0
success = 0
trial_type = None

@returns(Tuple[float, float, float, float, float, float, float])
def process(value):
  global r, state, a, success, trial_type, gr
  min_row = value.Item2.Item4[0][int(value.Item2.Item2)][0]
  max_row = value.Item2.Item4[0][int(value.Item2.Item2)][1]
  x = -value.Item2.Item1[r][3]#*0.90-0.20
  y = value.Item2.Item1[r][2]
  gx = -value.Item2.Item1[gr][3]#*0.90-0.20
  gy = value.Item2.Item1[gr][2]
  mx = value.Item2.Item3.Nose_X
  my = value.Item2.Item3.Nose_Y
  dist = math.sqrt((gx - mx) ** 2 + (gy - my) ** 2)

  if value.Item2.Item2 == 0 and success &gt; 1:
    a = 0
    state = 6
  elif dist &lt; value.Item2.Item6 and state == 1 and value.Item2.Item2 &gt;= 0: #Approach Distance
    r += 3
    state = 2
  elif gr &lt; min_row:
    gr = min_row
    r = gr + 3
  elif r &lt; max_row and state == 2:# and dist &lt; value.Item2.Item6:
    r += 1
    gr += 1
    a = 1
    if dist &lt;  value.Item2.Item5: #Capture Distance
      r = max_row
      gr = max_row
      a = 0
      state = 3
      success += 1
  elif state == 3 or state == 4:
    state = 5
  elif r &gt;= max_row and state == 2:
    r = max_row
    gr = max_row
    a = 0
    state = 4
  elif r != max_row:
    a = 1
    state = 1
  
  return Tuple[float, float, float, float, float, float, float](gx, gy, mx, my, success, a, state)</ipy:Script>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="ipy:PythonTransform">
                <ipy:Name>Trial Logic</ipy:Name>
                <ipy:Description>Runs the current trial until the next trial is reached</ipy:Description>
                <ipy:Script>from System import Tuple
import math

r = 0
state = 1
a = 0
success = 0
trial_type = None

@returns(Tuple[float, float, float, float, float, float, float])
def process(value):
  global r, state, a, success, trial_type
  min_row = value.Item2.Item4[0][int(value.Item2.Item2)][0]
  max_row = value.Item2.Item4[0][int(value.Item2.Item2)][1]
  x = -value.Item2.Item1[r][3]#*0.90-0.20
  y = value.Item2.Item1[r][2]
  mx = value.Item2.Item3.Nose_X
  my = value.Item2.Item3.Nose_Y
  dist = math.sqrt((x - mx) ** 2 + (y - my) ** 2)

  if value.Item2.Item2 == 0 and success &gt; 1:
    a = 0
    state = 6
  elif dist &lt; value.Item2.Item6 and state == 1 and value.Item2.Item2 &gt;= 0: #Approach Distance
    state = 2
  elif r &lt; min_row:
    r = min_row
  elif r &lt; max_row and state == 2:# and dist &lt; value.Item2.Item6:
    r += 1
    a = 1
    if dist &lt;  value.Item2.Item5: #Capture Distance
      r = max_row
      a = 0
      state = 3
      success += 1
  elif state == 3 or state == 4:
    state = 5
  elif r &gt;= max_row and state == 2:
    r = max_row
    a = 0
    state = 4
  elif r != max_row:
    a = 1
    state = 1
  
  return Tuple[float, float, float, float, float, float, float](x, y, mx, my, success, a, state)</ipy:Script>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="ipy:PythonTransform">
                <ipy:Name>Trial Logic DLC</ipy:Name>
                <ipy:Description>Runs the current trial until the next trial is reached</ipy:Description>
                <ipy:Script>from System import Tuple
import math

r = 0
state = 1
a = 0
success = 0
trial_type = None

@returns(Tuple[float, float, float, float, float, float, float])
def process(value):
  global r, state, a, success, trial_type
  min_row = value.Item2.Item4[0][int(value.Item2.Item2)][0]
  max_row = value.Item2.Item4[0][int(value.Item2.Item2)][1]
  x = -value.Item2.Item1[r][3]#*0.90-0.20
  y = value.Item2.Item1[r][2]
  mx = value.Item2.Item3.Nose_X
  my = value.Item2.Item3.Nose_Y
  dx = value.Item2.Item7.Dot_X
  dy = value.Item2.Item7.Dot_Y
  dist = math.sqrt((dx - mx) ** 2 + (dy - my) ** 2)

  if value.Item2.Item2 == 0 and success &gt; 1:
    a = 0
    state = 6
  elif dist &lt; value.Item2.Item6 and state == 1 and value.Item2.Item2 &gt;= 0: #Approach Distance
    state = 2
  elif r &lt; min_row:
    r = min_row
  elif r &lt; max_row and state == 2:# and dist &lt; value.Item2.Item6:
    r += 1
    a = 1
    if dist &lt;  value.Item2.Item5: #Capture Distance
      r = max_row
      a = 0
      state = 3
      success += 1
  elif state == 3 or state == 4:
    state = 5
  elif r &gt;= max_row and state == 2:
    r = max_row
    a = 0
    state = 4
  elif r != max_row:
    a = 1
    state = 1
  
  return Tuple[float, float, float, float, float, float, float](x, y, mx, my, success, a, state)</ipy:Script>
              </Builder>

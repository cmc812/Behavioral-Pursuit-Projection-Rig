              <ipy:Script>from System import Tuple, Array

first = []
last = []
r = 0
trial = 1
trial_bounds = {}

@returns(list)
def process(value):
  global first, last, r, trial

  for r in range(len(value)):
    if value[r][4] == trial:
      first.append(r)
      if r &gt; 0:
        last.append(r-1)
      trial += 1

  last.append(len(value)-1)
  bounds = list(zip(first, last))
    
  return bounds</ipy:Script>

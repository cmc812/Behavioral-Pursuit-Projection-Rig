              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Script>import clr
clr.AddReference("System")
from System.Net import WebRequest
from System.IO import StreamReader
from System.Text import Encoding

OE_URL = "http://localhost:37497"

def put_json(endpoint, json_str):
    req = WebRequest.Create(OE_URL + endpoint)
    req.Method = "PUT"
    req.ContentType = "application/json"
    data = Encoding.UTF8.GetBytes(json_str)
    req.ContentLength = data.Length
    stream = req.GetRequestStream()
    stream.Write(data, 0, data.Length)
    stream.Close()
    resp = req.GetResponse()
    reader = StreamReader(resp.GetResponseStream())
    result = reader.ReadToEnd()
    reader.Close()
    resp.Close()
    return result

@returns(bool)
def process(value):
    put_json("/api/status", '{"mode": "IDLE"}')
    return True</ipy:Script>

              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Name>Random Dot Location</ipy:Name>
                <ipy:Script>import random
from System import Tuple

coords = [0,0]

@returns(Tuple[float, float])
def process(value):
  global coords
  if value.Item1 == 49 and value.Item2 == True:
    coords = [random.uniform(-0.8, -0.27), random.uniform(-0.8, -0.27)]
  elif value.Item1 == 50 and value.Item2 == True:
    coords = [random.uniform(-0.8, -0.27), random.uniform(-0.27, 0.27)]
  elif value.Item1 == 51 and value.Item2 == True:
    coords = [random.uniform(-0.8, -0.27), random.uniform(0.27, 0.8)]
  elif value.Item1 == 52 and value.Item2 == True:
    coords = [random.uniform(-0.27, 0.27), random.uniform(-0.8, -0.27)]
  elif value.Item1 == 53 and value.Item2 == True:
    coords = [random.uniform(-0.27, 0.27), random.uniform(-0.27, 0.27)]
  elif value.Item1 == 54 and value.Item2 == True:
    coords = [random.uniform(-0.27, 0.27), random.uniform(0.27, 0.8)]
  elif value.Item1 == 55 and value.Item2 == True:
    coords = [random.uniform(0.27, 0.8), random.uniform(-0.8, -0.27)]
  elif value.Item1 == 56 and value.Item2 == True:
    coords = [random.uniform(0.27, 0.8), random.uniform(-0.27, 0.27)]
  elif value.Item1 == 57 and value.Item2 == True:
    coords = [random.uniform(0.27, 0.8), random.uniform(0.27, 0.8)]
  return Tuple[float, float](coords[0], coords[1])</ipy:Script>

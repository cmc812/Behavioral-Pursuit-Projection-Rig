  ? it.Substring(0, it.IndexOfAny("0123456789".ToCharArray()))
  : it
</scr:Expression>
              </Expression>
              <Expression xsi:type="rx:BehaviorSubject">
                <Name>Trial Type</Name>
              </Expression>

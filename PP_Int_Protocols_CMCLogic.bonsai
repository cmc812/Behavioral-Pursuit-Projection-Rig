                <Combinator xsi:type="rx:Merge" />
              </Expression>
              <Expression xsi:type="rx:Condition">
                <Workflow>
                  <Nodes>
                    <Expression xsi:type="WorkflowInput">
                      <Name>Source1</Name>
                    </Expression>
                    <Expression xsi:type="Equal">
                      <Operand xsi:type="WorkflowProperty" TypeArguments="sys:Byte">
                        <Value>12</Value>
                      </Operand>
                    </Expression>
                    <Expression xsi:type="WorkflowOutput" />
                  </Nodes>
                  <Edges>
                    <Edge From="0" To="1" Label="Source1" />
                    <Edge From="1" To="2" Label="Source1" />
                  </Edges>
                </Workflow>
              </Expression>
              <Expression xsi:type="rx:BehaviorSubject">
                <Name>Arrow</Name>
              </Expression>
              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Name>Trial Count</ipy:Name>
                <ipy:Script>from System import Tuple

trial = -1
check = False

@returns(Tuple[float, bool])
def process(value):
  global trial, check
  if trial + 1 != 30 and check == False:
    trial += 1
  else:
    trial = 0
    check = True
  return Tuple[float, bool](trial, check)</ipy:Script>
              </Expression>
              <Expression xsi:type="MemberSelector">
                <Selector>Item1</Selector>
              </Expression>
              <Expression xsi:type="rx:BehaviorSubject">
                <Name>Trial Count</Name>
              </Expression>
              <Expression xsi:type="SubscribeSubject">
                <Name>Nose Location</Name>
              </Expression>
              <Expression xsi:type="SubscribeSubject">
                <Name>Trial Bounds</Name>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="FloatProperty">
                  <Value>0.1</Value>
                </Combinator>
              </Expression>
              <Expression xsi:type="scr:ExpressionTransform">
                <scr:Name>Capture Distance</scr:Name>
                <scr:Expression>it</scr:Expression>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="FloatProperty">
                  <Value>0.7</Value>
                </Combinator>
              </Expression>
              <Expression xsi:type="SubscribeSubject">
                <Name>Dot Tracking</Name>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:CombineLatest" />
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:WithLatestFrom" />
              </Expression>
              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Name>Trial Logic</ipy:Name>
                <ipy:Description>Runs the current trial until the next trial is reached</ipy:Description>
                <ipy:Script>from System import Tuple
import math

r = 0
state = 1
a = 0
success = 0
trial_type = None

@returns(Tuple[float, float, float, float, float, float, float])
def process(value):
  global r, state, a, success, trial_type
  min_row = value.Item2.Item4[0][int(value.Item2.Item2)][0]
  max_row = value.Item2.Item4[0][int(value.Item2.Item2)][1]
  x = -value.Item2.Item1[r][3]#*0.90-0.20
  y = value.Item2.Item1[r][2]
  mx = value.Item2.Item3.Nose_X
  my = value.Item2.Item3.Nose_Y
  dist = math.sqrt((x - mx) ** 2 + (y - my) ** 2)

  if value.Item2.Item2 == 0 and success &gt; 1:
    a = 0
    state = 6
  elif dist &lt; value.Item2.Item6 and state == 1 and value.Item2.Item2 &gt;= 0: #Approach Distance
    state = 2
  elif r &lt; min_row:
    r = min_row
  elif r &lt; max_row and state == 2:# and dist &lt; value.Item2.Item6:
    r += 1
    a = 1
    if dist &lt;  value.Item2.Item5: #Capture Distance
      r = max_row
      a = 0
      state = 3
      success += 1
  elif state == 3 or state == 4:
    state = 5
  elif r &gt;= max_row and state == 2:
    r = max_row
    a = 0
    state = 4
  elif r != max_row:
    a = 1
    state = 1
  
  return Tuple[float, float, float, float, float, float, float](x, y, mx, my, success, a, state)</ipy:Script>
              </Expression>
              <Expression xsi:type="Disable">
                <Builder xsi:type="ipy:PythonTransform">
                  <ipy:Name>Trial Logic DLC</ipy:Name>
                  <ipy:Description>Runs the current trial until the next trial is reached</ipy:Description>
                  <ipy:Script>from System import Tuple
import math

r = 0
state = 1
a = 0
success = 0
trial_type = None

@returns(Tuple[float, float, float, float, float, float, float])
def process(value):
  global r, state, a, success, trial_type
  min_row = value.Item2.Item4[0][int(value.Item2.Item2)][0]
  max_row = value.Item2.Item4[0][int(value.Item2.Item2)][1]
  x = -value.Item2.Item1[r][3]#*0.90-0.20
  y = value.Item2.Item1[r][2]
  mx = value.Item2.Item3.Nose_X
  my = value.Item2.Item3.Nose_Y
  dx = value.Item2.Item7.Dot_X
  dy = value.Item2.Item7.Dot_Y
  dist = math.sqrt((dx - mx) ** 2 + (dy - my) ** 2)

  if value.Item2.Item2 == 0 and success &gt; 1:
    a = 0
    state = 6
  elif dist &lt; value.Item2.Item6 and state == 1 and value.Item2.Item2 &gt;= 0: #Approach Distance
    state = 2
  elif r &lt; min_row:
    r = min_row
  elif r &lt; max_row and state == 2:# and dist &lt; value.Item2.Item6:
    r += 1
    a = 1
    if dist &lt;  value.Item2.Item5: #Capture Distance
      r = max_row
      a = 0
      state = 3
      success += 1
  elif state == 3 or state == 4:
    state = 5
  elif r &gt;= max_row and state == 2:
    r = max_row
    a = 0
    state = 4
  elif r != max_row:
    a = 1
    state = 1
  
  return Tuple[float, float, float, float, float, float, float](x, y, mx, my, success, a, state)</ipy:Script>
                </Builder>
              </Expression>

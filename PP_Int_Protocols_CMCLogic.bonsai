              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:WithLatestFrom" />
              </Expression>
              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Name>DD Trial Logic</ipy:Name>
                <ipy:Description>Runs the current trial until the next trial is reached</ipy:Description>
                <ipy:Script>from System import Tuple
import math

r = 0
state = 0
a = 0
success = 0
trial_type = None
count = 0

@returns(Tuple[float, float, float, float, float, float, float])
def process(value):
  global r, state, a, success, trial_type, count
  min_row = value.Item2.Item4[0][int(value.Item2.Item2)][0]
  max_row = value.Item2.Item4[0][int(value.Item2.Item2)][1]
  x = -value.Item2.Item1[r][3]
  y = value.Item2.Item1[r][2]
  mx = value.Item2.Item3.Nose_X
  my = value.Item2.Item3.Nose_Y
  dist = math.sqrt((x - mx) ** 2 + (y - my) ** 2)
  
  max_frames = int(value.Item2.Item7 * 30 * 60)

  if value.Item2.Item2 == 0 and success &gt; 1:
    a = 0
    state = 6
    count = 0
  elif state in (1, 2) and count &gt;= max_frames:
    a = 0
    state = 4
    r = max_row
    count = 0
  elif dist &lt; value.Item2.Item6 and state == 0 and value.Item2.Item2 &gt;= 0:
    state = 1
    count = 0
  elif r &lt; min_row:
    r = min_row
  elif r &lt; max_row and state == 1:
    r += 1
    a = 1
    count += 1
    if dist &lt; value.Item2.Item5:
      r = max_row
      a = 0
      state = 3
      success += 1
      count = 0
  elif r &gt; min_row and state == 2:
    r -= 1
    a = 1
    count += 1
    if dist &lt; value.Item2.Item5:
      r = max_row
      a = 0
      state = 3
      success += 1
      count = 0
  elif state == 3:
    state = 5
  elif state == 4:
    state = 5
  elif r &gt;= max_row and state == 1:
    r = max_row - 1
    state = 2
  elif r == min_row and state == 2:
    state = 1
    r = min_row + 1
  elif r != max_row:
    a = 1
    state = 0

  return Tuple[float, float, float, float, float, float, float](x, y, mx, my, success, a, state)</ipy:Script>
              </Expression>
              <Expression xsi:type="Disable">
                <Builder xsi:type="ipy:PythonTransform">
                  <ipy:Name>Trial Logic</ipy:Name>
                  <ipy:Description>Runs the current trial until the next trial is reached</ipy:Description>
                  <ipy:Script>from System import Tuple
import math

gr = 0 #ghost dot
r = 0
state = 1
a = 0
success = 0
trial_type = None

@returns(Tuple[float, float, float, float, float, float, float])
def process(value):
  global r, state, a, success, trial_type, gr
  min_row = value.Item2.Item4[0][int(value.Item2.Item2)][0]
  max_row = value.Item2.Item4[0][int(value.Item2.Item2)][1]
  x = -value.Item2.Item1[r][3]#*0.90-0.20
  y = value.Item2.Item1[r][2]
  gx = -value.Item2.Item1[gr][3]#*0.90-0.20
  gy = value.Item2.Item1[gr][2]
  mx = value.Item2.Item3.Nose_X
  my = value.Item2.Item3.Nose_Y
  dist = math.sqrt((gx - mx) ** 2 + (gy - my) ** 2)

  if value.Item2.Item2 == 0 and success &gt; 1:
    a = 0
    state = 6
  elif dist &lt; value.Item2.Item6 and state == 1 and value.Item2.Item2 &gt;= 0: #Approach Distance
    r += 3
    state = 2
  elif gr &lt; min_row:
    gr = min_row
    r = gr + 3
  elif r &lt; max_row and state == 2:# and dist &lt; value.Item2.Item6:
    r += 1
    gr += 1
    a = 1
    if dist &lt;  value.Item2.Item5: #Capture Distance
      r = max_row
      gr = max_row
      a = 0
      state = 3
      success += 1
  elif state == 3 or state == 4:
    state = 5
  elif r &gt;= max_row and state == 2:
    r = max_row
    gr = max_row
    a = 0
    state = 4
  elif r != max_row:
    a = 1
    state = 1
  
  return Tuple[float, float, float, float, float, float, float](gx, gy, mx, my, success, a, state)</ipy:Script>

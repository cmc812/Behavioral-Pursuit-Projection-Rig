                <Combinator xsi:type="rx:CombineLatest" />
              </Expression>
              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Name>Shape Control</ipy:Name>
                <ipy:Script>@returns(str)
def process(value):
  global name
  if value.Item1 == "RP" or value.Item1 == "CP":
    name = value.Item1
  elif value.Item1 == "PA" or value.Item1 == "PR":
    name = "RP"
  elif (value.Item1 == "CA" or value.Item1 == "CR") and value.Item2[0][int(value.Item3)] == 0:
    name = "RP"
  else:
    name = "Cheese"
  return name</ipy:Script>
              </Expression>

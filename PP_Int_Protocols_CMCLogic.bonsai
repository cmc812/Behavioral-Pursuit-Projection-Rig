                <Builder xsi:type="ipy:PythonTransform">
                  <ipy:Name>Near Door?</ipy:Name>
                  <ipy:Script>import math

sb = -1

@returns(int)
def process(value):
  global sb
  mouse = value.Item1
  state = value.Item2

  if math.isnan(mouse) and (state == 1 or state == 2):
    sb = 7
  elif not math.isnan(mouse) and state == 2:
    sb = 6
  elif not math.isnan(mouse) and state == 5:
    sb = 7
  else:
    sb = -1
  return sb</ipy:Script>
                </Builder>
              </Expression>
              <Expression xsi:type="Disable">
                <Builder xsi:type="ipy:PythonTransform">
                  <ipy:Name>In Arena?</ipy:Name>
                  <ipy:Script>from System import Tuple
import math

arena = -1
start = 0
ir = 0

@returns(Tuple[int, int])
def process(value):
  global arena, start, ir
  mouse = value.Item1
  state = value.Item2
  ard = value.Item3
  ard2 = value.Item4 # LED arduino

  if ard2 != 1:
    arena = 0
    start = 1
  elif start == 1 and ard == "SESSION_FLASH_DONE":
    arena = 4
    start = 0
  elif mouse == 0 and state == 1:
    arena = 2
    ir = 0
  elif mouse == 1 and state == 2:
    arena = 7
  elif mouse == 1 and state == 1:
    arena = 2
  elif state == 5 and ard.strip() == 'IR:1':
    ir = 1
  elif mouse == 0 and state == 5 and ir == 1:
    arena = 7
  elif mouse == 1 and state == 5 and ard.strip() == "DOOR_CLOSED":
    arena = 6
    ir = 0
  else:
    arena = -1
  return Tuple[int, int](arena, ir)</ipy:Script>
